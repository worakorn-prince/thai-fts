{
  "name": "thai-fts",
  "version": "0.1.1",
  "description": "tone-aware Thai full-text search with zero runtime dependencies",
  "author": "worakorn-prince",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "thai-fts": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs"
    },
    "./fts5": {
      "types": "./dist/fts5/index.d.ts",
      "import": "./dist/fts5/index.js",
      "require": "./dist/fts5/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.th.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/worakorn-prince/thai-fts.git"
  },
  "keywords": [
    "thai",
    "segmentation",
    "fts",
    "full-text-search",
    "tokenizer",
    "thai-language",
    "sqlite",
    "fts5"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test \"test/*.test.mjs\" \"test/*/*.test.mjs\"",
    "benchmark": "npm run build && node benchmark/run.mjs",
    "benchmark:quick": "npm run build && node benchmark/run.mjs --quick",
    "benchmark:quality": "npm run build && node benchmark/quality/run.mjs",
    "benchmark:perf": "npm run build && node benchmark/perf/diagnose.mjs",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
