{
  "name": "thai-fts",
  "version": "0.1.0",
  "description": "Zero-dependency Thai tokenization & FTS for Node — mark-aware segmentation, tone-tolerant matching, synonyms, SQLite FTS5.",
  "author": "worakorn-prince",
  "license": "MIT",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "bin": {
    "thai-fts": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs"
    },
    "./fts5": {
      "types": "./dist/fts5/index.d.ts",
      "import": "./dist/fts5/index.js",
      "require": "./dist/fts5/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "npm run build && node --test test",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0"
  }
}
